# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS Policy (comma-separated origins, or * in local dev only)
CORS_ORIGIN=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=
REQUIRE_GEMINI_API_KEY=false

# Gemini Model Configuration
GEMINI_MODEL_PRIMARY=gemini-4-hydrogen
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-4-hydrogen

# APP_URL: The URL where this applet is hosted.
APP_URL=
